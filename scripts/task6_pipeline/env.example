# Copy this file to `.env` or source it before running the task6 pipeline.
# Keep site/local paths here; do not commit machine-specific values.

PYTHON=python
ACCELERATE=accelerate

# External model/checkpoint assets.
PI05_BASE_PARAMS=gs://openpi-assets/checkpoints/pi05_base/params
TOKENIZER_PATH=/path/to/paligemma_tokenizer.model
VJEPA_MODEL_PATH=/path/to/vjepa2/vitg-384.pt

# Optional: override when V-JEPA2 is not vendored under third_party/vjepa2.
# VJEPA2_PATH=/path/to/vjepa2

# Source task6 LeRobot dataset containing demonstrations and rollout50.
TASK6_SOURCE_DATA=outputs/lerobot_policy_data/task6_demo_plus_policy_rollout50

# CtrlWorld augmentation assets.
CTRLWORLD_CKPT_PATH=/path/to/CtrlWorld/checkpoint.pt
CTRLWORLD_DATA_STAT_PATH=/path/to/CtrlWorld/stat.json
DYN_CKPT_PATH=/path/to/dynamics/checkpoint.pt
DYN_STAT_PATH=/path/to/dynamics/stat.json
CTRLWORLD_POLICY_CKPT=checkpoints/pi05_libero_task6_sft/10000
CONFIG_NAME=pi05_libero_task6_sft
